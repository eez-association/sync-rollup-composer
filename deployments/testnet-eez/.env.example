# deployments/testnet-eez/.env — operator-only secrets. NEVER commit.
# Copy to .env and fill in a freshly generated key.
#
# Generate a new builder key:
#   cast wallet new --json | jq -r '.[0].private_key'
#
# The key MUST be unique to this testnet and MUST NOT be dev#0
# (0xac0974… — the publicly-known reth --dev coinbase). See docs/issue-29
# for the 2026-04-15 livelock caused by sharing dev#0.

BUILDER_PRIVATE_KEY=0x_YOUR_BUILDER_PRIVATE_KEY_HERE

# ── Optional: point the Blockscout explorer frontends at your local devnet ──
#
# By default the L1/L2 explorer frontends fetch data from the public eez.dev
# deployment (l1.eez.dev / l2.eez.dev over https:443). That's correct for the
# public testnet but means a locally-running stack shows the public chain's
# data, not yours. To repoint the frontends at your local backend, uncomment
# the lines below.
#
# 127.0.0.1 works when:
#   - you're browsing from the same machine the devnet runs on, or
#   - you SSH-tunnel ports 4002/4003 from your local machine to the server
# Otherwise replace 127.0.0.1 with the server's reachable hostname/IP.
#
# BLOCKSCOUT_L1_HOST=127.0.0.1
# BLOCKSCOUT_L1_PORT=4002
# BLOCKSCOUT_L1_PROTOCOL=http
# BLOCKSCOUT_L2_HOST=127.0.0.1
# BLOCKSCOUT_L2_PORT=4003
# BLOCKSCOUT_L2_PROTOCOL=http
